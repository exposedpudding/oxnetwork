# Installed as /etc/oxnetwork-dns.conf after replacing SERVICE_VIP.
# Serves only the Tailscale interface; other oxnet.work records are forwarded.
interface=tailscale0
except-interface=lo
bind-dynamic
no-resolv
no-hosts
server=1.1.1.1
server=9.9.9.9
domain-needed
bogus-priv
cache-size=1000
host-record=oxnet.work,SERVICE_VIP
host-record=auth.oxnet.work,SERVICE_VIP
